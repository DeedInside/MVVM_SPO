<Window x:Class="MVVM_SPO.View.AutorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVM_SPO.View"
        mc:Ignorable="d"
        Title="AutorizationWindow" Height="350" Width="400"
        FontSize="24">
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center">
        <StackPanel Margin="5" Orientation="Horizontal">
            <TextBox Text="{Binding Login}" Width="120"/>
            <Label Content="Login"/>
        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal">
            <TextBox Text="{Binding Password}" Width="120"/>
            <Label Content="Password"/>
        </StackPanel>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="выйти" Width="120"
                        Margin="0 0 5 0"/>
                <Button Content="войти" Width="120"/> 
            </StackPanel>
            <Button Content="Регистрация" Width="245"
                    Margin="0 5 0 0"/>
        </StackPanel>
    </StackPanel>
</Window>
