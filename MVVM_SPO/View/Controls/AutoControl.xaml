<UserControl x:Class="MVVM_SPO.View.Controls.AutoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MVVM_SPO.View.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450">
    <StackPanel VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <StackPanel Margin="5" Orientation="Horizontal">
            <TextBox Text="{Binding Login}" Width="120"/>
            <Label Content="Login"/>
        </StackPanel>
        <StackPanel Margin="5" Orientation="Horizontal">
            <TextBox Text="{Binding Password}" Width="120"/>
            <Label Content="Password"/>
        </StackPanel>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="выйти" Width="120"
                    Margin="0 0 5 0"
                        Command="{Binding ExitCommand}"/>
                <Button Content="войти" Width="120"
                        Command="{Binding AutorizationCommand}"/>
            </StackPanel>
            <Button Content="Регистрация" Width="245"
                Margin="0 5 0 0"
                    Command="{Binding RegCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
